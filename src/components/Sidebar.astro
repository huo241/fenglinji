---
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const posts = await getCollection('blog');
const essayCount = posts.filter((p) => p.data.category === '随笔').length;
const lectureCount = posts.filter((p) => p.data.category === '讲义').length;

const socialEntries = Object.values(SITE.socials).filter((s) => s?.url);
const customSocials = SITE.socials.custom ?? [];
// 邮箱填纯地址也行：自动补 mailto:
const emailHref = SITE.socials.email.url
  ? SITE.socials.email.url.startsWith('mailto:')
    ? SITE.socials.email.url
    : `mailto:${SITE.socials.email.url}`
  : '';
---

<aside class="sidebar">
  <div class="profile-card reveal">
    {SITE.avatarUrl ? (
      <img class="avatar avatar-photo" src={SITE.avatarUrl} alt={SITE.ownerName} loading="lazy" />
    ) : (
      <div class="avatar">{SITE.avatarText}</div>
    )}
    <div class="name">{SITE.ownerName}</div>
    <div class="bio" set:html={SITE.bio} />
    {socialEntries.length > 0 && (
      <div class="social-row">
        {SITE.socials.github.url && (
          <a href={SITE.socials.github.url} target="_blank" rel="noopener" aria-label={SITE.socials.github.label} title={SITE.socials.github.label}>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.47v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
          </a>
        )}
        {SITE.socials.email.url && (
          <a href={emailHref} aria-label={SITE.socials.email.label} title={SITE.socials.email.label}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
        )}
        {customSocials.filter((s) => s.url).map((s) => (
          <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3.5 9h17M3.5 15h17"/><path d="M12 3a14.5 14.5 0 0 1 0 18a14.5 14.5 0 0 1 0-18" /></svg>
          </a>
        ))}
        <a href="/admin/" class="owner-only" aria-label="写作台" title="写作台">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </a>
        <a href="/settings/" class="owner-only" aria-label="站点设置" title="站点设置">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </a>
      </div>
    )}
  </div>

  <div class="cats-card reveal" style="--reveal-delay:.12s">
    <h4>分类</h4>
    <a href="/essays/" class="cat-row"><span>随笔</span><span class="count">{essayCount} 篇</span></a>
    <a href="/lectures/" class="cat-row"><span>讲义</span><span class="count">{lectureCount} 篇</span></a>
  </div>
</aside>

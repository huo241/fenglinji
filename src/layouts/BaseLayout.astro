---
import { ClientRouter } from 'astro:transitions';
import { SITE, SECTIONS } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.name, description = `${SITE.motto} —— ${SITE.name}，随笔与讲义的私人园地` } = Astro.props;

const navItems = [
  { href: '/', label: '首页' },
  ...SECTIONS.map((s) => ({ href: `/${s.key}/`, label: s.label })),
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // 首屏防闪烁：只保留深色与纸墨两档；旧访客存的 light 归入纸墨
      (function () {
        var t = localStorage.getItem('theme');
        if (t === 'light') t = 'paper';
        if (t !== 'dark' && t !== 'paper') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'paper';
        document.documentElement.dataset.theme = t;
        document.documentElement.dataset.glass = localStorage.getItem('glass') === 'on' ? 'on' : 'off';
      })();
    </script>
  </head>

---
import { ClientRouter } from 'astro:transitions';
import { SITE, SECTIONS } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.name, description = `${SITE.motto} —— ${SITE.name}，随笔与讲义的私人园地` } = Astro.props;

const navItems = [
  { href: '/', label: '首页' },
  ...SECTIONS.map((s) => ({ href: `/${s.key}/`, label: s.label })),
  { href: '/about/', label: '关于' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // 首屏防闪烁：渲染前先定主题
      (function () {
        var t = localStorage.getItem('theme');
        if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <nav class="site-nav">
      <div class="container inner">
        <a href="/" class="brand" transition:name="brand">
          <svg class="mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="url(#lg)" />
            <path d="M7 12h13a3 3 0 1 0-3-3" stroke="#fff" stroke-width="2.2" stroke-linecap="round" fill="none" />
            <path d="M7 18h16a3 3 0 1 1-3 3" stroke="#fff" stroke-width="2.2" stroke-linecap="round" fill="none" />
            <path d="M7 24h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
            <defs>
              <linearGradient id="lg" x1="0" y1="0" x2="32" y2="32">
                <stop stop-color="#4b63e6" />
                <stop offset="1" stop-color="#7a4a9e" />
              </linearGradient>
            </defs>
          </svg>
          <span class="txt">{SITE.name}</span>
        </a>
        <div class="nav-links">
          {navItems.map((item) => (
            <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
              {item.label}
            </a>
          ))}
          <button id="theme-toggle" class="theme-toggle" aria-label="切换主题" title="切换主题">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="icon-glass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3.5c3.2 4 6 7.4 6 10.5a6 6 0 1 1-12 0c0-3.1 2.8-6.5 6-10.5z" />
              <path d="M9.5 14a2.6 2.6 0 0 0 2 2.6" stroke-width="1.6" opacity="0.7" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="site-footer">
      <div class="container">
        {SITE.footer}
      </div>
    </footer>

    <script>
      // ---- 主题切换（事件委托，页面转场后依然生效）----
      function applyTheme(t: string) {
        document.documentElement.dataset.theme = t;
        localStorage.setItem('theme', t);
      }
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('#theme-toggle')) {
          const order = ['light', 'dark', 'glass'];
          const cur = document.documentElement.dataset.theme || 'light';
          const next = order[(order.indexOf(cur) + 1) % order.length] || 'light';
          applyTheme(next);
        }
      });
      document.addEventListener('astro:after-swap', () => {
        applyTheme(localStorage.getItem('theme') || 'dark');
      });

      // ---- 滚动渐入（astro:page-load 首载与转场后都会触发）----
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.on)');
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add('on');
                io.unobserve(en.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SECTIONS } from '../config';

export async function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { category: s.key } }));
}

const { category: slug } = Astro.params;
const section = SECTIONS.find((s) => s.key === slug)!;
const cat = section.label;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.category === cat)
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`${cat} · 风林集`}>
  <main class="container">
    <div class="page-hero">
      <h1>{cat}</h1>
      <p>{section.tagline}</p>
    </div>
    <section style="max-width:820px;margin:0 auto 80px;">
      {posts.map((post, i) => <PostCard post={post} index={i} />)}
      {posts.length === 0 && (
        <p style="text-align:center;color:var(--muted);padding:60px 0;">这里还什么都没有，慢些来。</p>
      )}
    </section>
  </main>
</BaseLayout>

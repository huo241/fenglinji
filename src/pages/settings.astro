---
/**
 * 站点设置 /settings —— 自己改站名 / 文案 / 社交链接，不用找 AI
 * 与 /admin 共用同一枚 GitHub 令牌（localStorage: flj_gh_token）
 * 保存 = 直写仓库 src/data/site.json → Cloudflare 自动重新部署（约 1 分钟生效）
 */
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>站点设置 · 风林集</title>
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <nav class="site-nav">
      <div class="container inner">
        <a href="/" class="brand">
          <span class="txt">← 回到博客</span>
        </a>
        <div class="nav-links">
          <a href="/admin/">写作台</a>
        </div>
      </div>
    </nav>

    <main class="settings-main">
      <div class="settings-head">
        <h1>站点设置</h1>
        <p>改完点保存，约 1 分钟后线上生效。所有内容都存在你自己的仓库里。</p>
      </div>

      <!-- 未连接提示 -->
      <div id="setup-card" class="glass-card setup-card hidden">
        <h2>先连接 GitHub</h2>
        <p id="setup-hint">令牌按域名分别保存：正式域名上写作台连过的，这里能直接复用；<b>本地预览</b>（localhost）里读不到，需要粘一枚。</p>
        <div class="row" style="margin-bottom:12px;">
          <input id="input-token" type="text" placeholder="粘贴 github_pat_ 令牌" autocomplete="off" />
          <button id="btn-connect" class="btn primary" type="button">连 接</button>
        </div>
        <button id="btn-clip" class="btn ghost block" type="button" style="margin-bottom:12px;">📋 从剪贴板粘贴并连接</button>
        <p class="hint">怎么拿令牌：打开写作台 → 左上角 ☰ → 「连接设置」，令牌框里那一串就是，复制过来即可。</p>
        <details>
          <summary>没有令牌？重新生成一枚（1 分钟）</summary>
          <ol>
            <li>打开 <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">github.com/settings/personal-access-tokens/new</a></li>
            <li>Repository access 选 <b>Only select repositories</b> → 选 <code>fenglinji</code></li>
            <li>Permissions → <b>Contents: Read and write</b></li>
            <li>生成后把 <code>github_pat_</code> 开头的令牌粘到上面</li>
          </ol>
        </details>
      </div>

      <!-- 设置表单 -->
      <form id="settings-form" class="hidden" onsubmit="return false">
        <section class="glass-card">
          <h2>基本信息</h2>
          <div class="grid2">
            <label>站名<input id="f-name" type="text" /></label>
            <label>一句话标语（motto）<input id="f-motto" type="text" /></label>
          </div>
          <label>页脚文字<input id="f-footer" type="text" /></label>
        </section>

        <section class="glass-card">
          <h2>侧栏个人卡片</h2>
          <div class="grid2">
            <label>显示的名字<input id="f-owner" type="text" /></label>
            <label>头像文字（没头像图时显示）<input id="f-avatar-text" type="text" maxlength="2" /></label>
          </div>
          <label>头像图片地址（留空则显示上面的文字头像）<input id="f-avatar-url" type="url" placeholder="https://…" /></label>
          <label>个人简介（想换行就写 &lt;br/&gt;）<textarea id="f-bio" rows="2"></textarea></label>
        </section>

        <section class="glass-card">
          <h2>社交链接</h2>
          <div class="grid2">
            <label>GitHub 主页地址<input id="f-github" type="url" placeholder="留空则不显示" /></label>
            <label>邮箱（mailto: 或纯邮箱都行）<input id="f-email" type="text" placeholder="留空则不显示" /></label>
          </div>
          <p class="hint">下面的自定义链接会以图标形式排在 GitHub / 邮箱后面，鼠标悬停显示名字。</p>
          <div id="custom-list"></div>
          <button id="btn-add-social" class="btn ghost" type="button">＋ 添加一个链接</button>
        </section>

        <section class="glass-card">
          <h2>板块文案</h2>
          <p class="hint warn">板块名字同时决定文章归类，改了名字后，旧文章的「分类」也要在写作台里同步改，否则文章会从板块里消失。不想动就只改副标题。</p>
          <div id="section-list"></div>
        </section>

        <div class="save-bar">
          <span id="save-state"></span>
          <button id="btn-save" class="btn primary big" type="button">保 存</button>
        </div>
      </form>
    </main>

    <div id="toast" class="toast hidden"></div>

    <script>
      const GH = 'https://api.github.com';
      const $ = (id: string) => document.getElementById(id)!;
      const TOKEN_KEY = 'flj_gh_token';
      const REPO_KEY = 'flj_repo';

      let token = localStorage.getItem(TOKEN_KEY) || '';
      let repo = localStorage.getItem(REPO_KEY) || 'huo241/fenglinji';
      let siteJson: any = null;
      let fileSha = '';

      const b64of = (s: string) => btoa(unescape(encodeURIComponent(s)));

      window.addEventListener('error', (e) => {
        try { toast('出错了：' + e.message, false); } catch {}
      });

      function toast(msg: string, ok = true) {
        const t = $('toast');
        t.textContent = msg;
        t.className = 'toast' + (ok ? '' : ' err');
        clearTimeout((t as any)._h);
        (t as any)._h = setTimeout(() => t.classList.add('hidden'), 3200);
      }

      async function gh(method: string, path: string, body?: any) {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 20000);
        let res: Response;
        try {
          res = await fetch(`${GH}/repos/${repo}/contents/${path}`, {
            method,
            headers: {
              Authorization: `Bearer ${token}`,
              Accept: 'application/vnd.github+json',
              'Content-Type': 'application/json',
            },
            body: body ? JSON.stringify(body) : undefined,
            signal: ctrl.signal,
          });
        } catch (e: any) {
          throw new Error(e.name === 'AbortError' ? '请求超时，稍后再试' : '网络请求失败：' + e.message);
        } finally {
          clearTimeout(timer);
        }
        if (!res.ok) throw new Error(`GitHub ${res.status}: ${(await res.json()).message || ''}`);
        return res.json();
      }

      // ---------- 自定义社交链接行 ----------
      function addSocialRow(label = '', url = '') {
        const row = document.createElement('div');
        row.className = 'social-edit-row';
        row.innerHTML = `
          <input class="se-label" type="text" placeholder="名字（如：微博 / B站 / 豆瓣）" value="${label.replace(/"/g, '&quot;')}" />
          <input class="se-url" type="url" placeholder="https://…" value="${url.replace(/"/g, '&quot;')}" />
          <button class="se-del" type="button" title="删除">✕</button>`;
        row.querySelector('.se-del')!.addEventListener('click', () => row.remove());
        $('custom-list').appendChild(row);
      }

      // ---------- 板块行 ----------
      function addSectionRow(key: string, label: string, tagline: string) {
        const row = document.createElement('div');
        row.className = 'section-edit-row';
        row.innerHTML = `
          <code class="sec-key">${key}</code>
          <input class="sec-label" type="text" value="${label.replace(/"/g, '&quot;')}" />
          <input class="sec-tagline" type="text" value="${tagline.replace(/"/g, '&quot;')}" placeholder="副标题" />`;
        $('section-list').appendChild(row);
      }

      // ---------- 载入 ----------
      function fillForm(json: any) {
        ($('f-name') as HTMLInputElement).value = json.name || '';
        ($('f-motto') as HTMLInputElement).value = json.motto || '';
        ($('f-footer') as HTMLInputElement).value = json.footer || '';
        ($('f-owner') as HTMLInputElement).value = json.ownerName || '';
        ($('f-avatar-text') as HTMLInputElement).value = json.avatarText || '';
        ($('f-avatar-url') as HTMLInputElement).value = json.avatarUrl || '';
        ($('f-bio') as HTMLTextAreaElement).value = (json.bio || '').replace(/<br\s*\/?>/gi, '\n');
        ($('f-github') as HTMLInputElement).value = json.socials?.github?.url || '';
        ($('f-email') as HTMLInputElement).value = json.socials?.email?.url || '';
        $('custom-list').innerHTML = '';
        (json.socials?.custom || []).forEach((s: any) => addSocialRow(s.label, s.url));
        $('section-list').innerHTML = '';
        (json.sections || []).forEach((s: any) => addSectionRow(s.key, s.label, s.tagline));
      }

      async function loadSettings() {
        $('save-state').textContent = '载入中…';
        try {
          const file = await gh('GET', 'src/data/site.json');
          fileSha = file.sha;
          siteJson = JSON.parse(decodeURIComponent(escape(atob(file.content.replace(/\n/g, '')))));
          fillForm(siteJson);
          $('setup-card').classList.add('hidden');
          $('settings-form').classList.remove('hidden');
          $('save-state').textContent = '';
        } catch (e: any) {
          $('save-state').textContent = '';
          toast('载入失败：' + e.message, false);
        }
      }

      // ---------- 连接 ----------
      async function connect(t?: string) {
        const val = (t ?? ($('input-token') as HTMLInputElement).value).trim();
        if (!val) return toast('先粘贴令牌', false);
        token = val;
        const btn = $('btn-connect') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = '连接中…';
        try {
          await gh('GET', 'src/data/site.json');
          localStorage.setItem(TOKEN_KEY, token);
          localStorage.setItem(REPO_KEY, repo);
          toast('已连接 ' + repo);
          await loadSettings();
        } catch (e: any) {
          toast('连接失败：' + e.message, false);
        } finally {
          btn.disabled = false; btn.textContent = '连 接';
        }
      }
      $('btn-connect').addEventListener('click', () => connect());
      $('btn-clip').addEventListener('click', async () => {
        try {
          const txt = (await navigator.clipboard.readText()).trim();
          if (!txt) return toast('剪贴板是空的——先去写作台复制令牌', false);
          ($('input-token') as HTMLInputElement).value = txt;
          await connect(txt);
        } catch {
          toast('浏览器不让读剪贴板，请手动粘进输入框', false);
        }
      });

      // ---------- 保存 ----------
      $('btn-add-social').addEventListener('click', () => addSocialRow());

      function esc(v: string) {
        return v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      $('btn-save').addEventListener('click', async () => {
        const btn = $('btn-save') as HTMLButtonElement;
        btn.disabled = true;
        $('save-state').textContent = '保存中…';
        try {
          const json = JSON.parse(JSON.stringify(siteJson)); // 保留未知字段
          json.name = ($('f-name') as HTMLInputElement).value.trim();
          json.motto = ($('f-motto') as HTMLInputElement).value.trim();
          json.footer = ($('f-footer') as HTMLInputElement).value.trim();
          json.ownerName = ($('f-owner') as HTMLInputElement).value.trim();
          json.avatarText = ($('f-avatar-text') as HTMLInputElement).value.trim();
          json.avatarUrl = ($('f-avatar-url') as HTMLInputElement).value.trim();
          json.bio = ($('f-bio') as HTMLTextAreaElement).value.trim().replace(/\n/g, '<br/>');
          json.socials = json.socials || {};
          json.socials.github = { ...(json.socials.github || {}), url: ($('f-github') as HTMLInputElement).value.trim() };
          json.socials.email = { ...(json.socials.email || {}), url: ($('f-email') as HTMLInputElement).value.trim() };
          json.socials.custom = Array.from(document.querySelectorAll('#custom-list .social-edit-row'))
            .map((row) => ({
              label: (row.querySelector('.se-label') as HTMLInputElement).value.trim(),
              url: (row.querySelector('.se-url') as HTMLInputElement).value.trim(),
            }))
            .filter((s) => s.url);
          document.querySelectorAll('#section-list .section-edit-row').forEach((row, i) => {
            if (!json.sections?.[i]) return;
            const lb = (row.querySelector('.sec-label') as HTMLInputElement).value.trim();
            const tg = (row.querySelector('.sec-tagline') as HTMLInputElement).value.trim();
            if (lb) json.sections[i].label = lb;
            json.sections[i].tagline = tg;
          });

          await gh('PUT', 'src/data/site.json', {
            message: '站点设置更新（网页端）',
            content: b64of(JSON.stringify(json, null, 2) + '\n'),
            sha: fileSha,
          });
          fileSha = (await gh('GET', 'src/data/site.json')).sha;
          siteJson = json;
          $('save-state').textContent = '已保存 ✓ 约 1 分钟后线上生效';
          toast('已保存！构建大约 1 分钟后生效');
        } catch (e: any) {
          $('save-state').textContent = '';
          toast('保存失败：' + e.message, false);
        } finally {
          btn.disabled = false;
        }
      });

      // ---------- 启动 ----------
      if (token) {
        loadSettings();
      } else {
        $('setup-card').classList.remove('hidden');
      }
    </script>
  </body>
</html>

<style>
  .settings-main {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px 100px;
  }
  .settings-head h1 {
    font-family: var(--serif);
    font-size: 30px;
    letter-spacing: 4px;
    margin: 0 0 8px;
  }
  .settings-head p {
    color: var(--muted);
    font-size: 14px;
    margin: 0 0 28px;
  }
  .glass-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 26px 28px;
    margin-bottom: 22px;
  }
  .glass-card h2 {
    font-family: var(--serif);
    font-size: 18px;
    letter-spacing: 2px;
    margin: 0 0 18px;
  }
  .glass-card label {
    display: block;
    font-size: 13.5px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .glass-card input,
  .glass-card textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-top: 5px;
    padding: 9px 12px;
    font-size: 14.5px;
    font-family: var(--sans);
    color: var(--text);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .glass-card input:focus,
  .glass-card textarea:focus {
    border-color: var(--accent);
  }
  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 16px;
  }
  @media (max-width: 560px) {
    .grid2 { grid-template-columns: 1fr; }
  }
  .hint {
    font-size: 12.5px;
    color: var(--muted);
    margin: 4px 0 12px;
  }
  .hint.warn {
    background: var(--accent-soft);
    border-radius: 8px;
    padding: 8px 12px;
  }
  .social-edit-row,
  .section-edit-row {
    display: grid;
    grid-template-columns: 1fr 1.6fr auto;
    gap: 8px;
    margin-bottom: 10px;
    align-items: center;
  }
  .section-edit-row {
    grid-template-columns: 84px 1fr 1.8fr;
  }
  .social-edit-row input,
  .section-edit-row input {
    margin-top: 0;
    padding: 8px 10px;
    font-size: 13.5px;
  }
  .sec-key {
    font-size: 12.5px;
    color: var(--muted);
    background: var(--bg-soft);
    border-radius: 8px;
    padding: 6px 10px;
    text-align: center;
  }
  .se-del {
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .se-del:hover {
    color: #f43f5e;
    border-color: #f43f5e;
  }
  .setup-card details {
    font-size: 13.5px;
    color: var(--muted);
  }
  .setup-card summary {
    cursor: pointer;
    margin-bottom: 8px;
  }
  .btn.block { display: block; width: 100%; }
  .setup-card h2 { margin-bottom: 10px; }
  .setup-card p, .setup-card ol, .setup-card li {
    font-size: 14px;
    color: var(--muted);
  }
  .setup-card ol { padding-left: 20px; margin: 10px 0 16px; }
  .setup-card li { margin-bottom: 6px; }
  .setup-card code {
    background: var(--bg-soft);
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 12.5px;
  }
  .row { display: flex; gap: 10px; }
  .row input {
    flex: 1;
    margin-top: 0;
  }
  .btn {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 10px;
    padding: 9px 18px;
    font-size: 14.5px;
    cursor: pointer;
    font-family: var(--sans);
    transition: transform 0.2s var(--ease-out), opacity 0.2s;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:disabled { opacity: 0.55; cursor: wait; }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn.big { padding: 12px 42px; font-size: 15.5px; }
  .btn.ghost { background: var(--bg-soft); }
  .link-btn {
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    font-size: 14px;
    padding: 0;
    text-decoration: underline;
  }
  .save-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }
  #save-state {
    font-size: 13.5px;
    color: var(--muted);
  }
  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--text);
    color: var(--bg);
    padding: 10px 22px;
    border-radius: 999px;
    font-size: 14px;
    z-index: 99;
    box-shadow: var(--shadow);
  }
  .toast.err { background: #f43f5e; color: #fff; }
  .hidden { display: none !important; }
</style>

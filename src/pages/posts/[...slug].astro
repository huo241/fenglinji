---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, category, tags } = post.data;
const { Content } = await render(post);

const fmt = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<BaseLayout title={`${title} · 风林集`} description={description}>
  <main class="container">
    <article class="prose" style="margin-top:48px;">
      <h1 transition:name={`post-title-${post.id}`}>{title}</h1>
      <div class="prose-meta">
        <span>{fmt(date)}</span>
        <span><a href={category === '随笔' ? '/essays/' : '/lectures/'} style="color:var(--accent)">{category}</a></span>
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <Content />
      <Comments />
      <a href="/" class="back-link">← 回到首页</a>
    </article>
  </main>
</BaseLayout>
